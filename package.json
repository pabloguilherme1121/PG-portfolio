{
  "name": "pablo-guilherme-portfolio",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-workspace.mjs dev",
    "build": "node scripts/run-workspace.mjs static",
    "start": "node scripts/run-workspace.mjs api-start",
    "check": "node scripts/run-workspace.mjs check",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "pnpm --filter @pg/api exec drizzle-kit generate --config=../../drizzle.config.ts && pnpm --filter @pg/api exec drizzle-kit migrate --config=../../drizzle.config.ts",
    "audit:assets": "node scripts/audit-public-assets.mjs",
    "audit:bundle": "node scripts/check-bundle-budget.mjs",
    "build:server": "node scripts/run-workspace.mjs server",
    "build:static": "node scripts/run-workspace.mjs static",
    "test:e2e:static": "playwright test --config=playwright.static.config.ts",
    "dev:server": "node scripts/run-workspace.mjs api-dev",
    "check:portfolio": "tsc --noEmit -p apps/portfolio/tsconfig.json",
    "check:api": "tsc --noEmit -p apps/api/tsconfig.json",
    "audit:source": "node scripts/check-source-escapes.mjs",
    "lint": "pnpm dlx oxlint@1.86.0 apps/portfolio/src apps/api/src apps/api/client apps/api/drizzle packages/contracts scripts drizzle.config.ts vite.config.ts playwright.config.ts playwright.static.config.ts",
    "test:portfolio": "vitest run apps/portfolio/src",
    "test:api": "vitest run apps/api/src"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.18",
      "postcss>nanoid": "3.3.18",
      "@tailwindcss/oxide>tar": "7.5.21",
      "vite>rollup": "4.59.0",
      "vite>picomatch": "4.0.4",
      "@babel/helper-compilation-targets>browserslist": "4.28.7",
      "axios>form-data": "4.0.6",
      "vitest>picomatch": "4.0.4",
      "qs": "6.16.0",
      "@esbuild-kit/core-utils>esbuild": "0.25.10",
      "@babel/core": "7.29.6",
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  },
  "private": true
}
