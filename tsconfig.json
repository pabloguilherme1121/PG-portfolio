{
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/workspace.tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./apps/portfolio/src/*"],
      "@shared/*": ["./packages/contracts/*"],
      "@api/*": ["./apps/api/client/*"],
      "@portfolio/bootstrap": ["./apps/portfolio/src/bootstrapStatic.tsx"]
    },
    "target": "ES2022"
  }
}
